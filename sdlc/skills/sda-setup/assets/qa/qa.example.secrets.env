# QA credentials placeholder
# Copy this file to qa.secrets.env and fill in real values.
# Never commit real credential values.

# A test-user authentication token
QA_USER_TOKEN=<paste-a-test-user-auth-token-here>

# Read-only database connection string
QA_DB_URL=<read-only-db-connection-string-here>

# Base URL for the API under test
QA_API_BASE_URL=http://localhost:3000
